#!/usr/bin/env bash
# Applies the system configuration this setup needs, idempotently:
#   - greetd runs noctalia-greeter (this creates the greeter user; noctalia-greeter's setup script
#     prepares PAM, its paths and the appearance sync)
#   - Plymouth boot splash with the bgrt theme (mkinitcpio hook, `splash` on the limine cmdline),
#     with the boot images rebuilt whenever that configuration changes
#   - transparent hugepages in madvise mode
#
#   sudo dotfiles-system     apply what is missing
#   dotfiles-system --check  report what would change, without root; exits 1 if anything would
#
# Revert: delete /etc/tmpfiles.d/thp.conf, remove
# `plymouth` from HOOKS in /etc/mkinitcpio.conf and `splash` from KERNEL_CMDLINE in
# /etc/default/limine, run limine-mkinitcpio, and enable another display manager.
set -euo pipefail

check=false
[[ ${1:-} == --check ]] && check=true
if ! $check && ((EUID != 0)); then
	echo "dotfiles-system: run with sudo, or pass --check" >&2
	exit 1
fi
pending=0

# ensure <description> <predicate> <action>: reports the fact; outside check mode runs the action
# when the predicate fails.
ensure() {
	if "$2"; then
		echo "ok      $1"
	elif $check; then
		echo "change  $1"
		pending=1
	else
		echo "apply   $1"
		"$3"
	fi
}

thp_path=/etc/tmpfiles.d/thp.conf
thp='w /sys/kernel/mm/transparent_hugepage/enabled - - - - madvise'
thp_set() { [[ -f $thp_path && $(<"$thp_path") == "$thp" ]]; }
thp_apply() {
	install -Dm644 /dev/stdin "$thp_path" <<<"$thp"
	systemd-tmpfiles --create "$thp_path"
}
ensure "transparent hugepages: madvise" thp_set thp_apply

# Plymouth must start before the root filesystem is mounted, right after systemd or udev.
hook_set() { grep -Eq '^HOOKS=\(.*\<plymouth\>' /etc/mkinitcpio.conf; }
hook_apply() {
	if grep -Eq '^HOOKS=\(.*\<systemd\>' /etc/mkinitcpio.conf; then
		sed -Ei '/^HOOKS=\(/ s/\<systemd\>/systemd plymouth/' /etc/mkinitcpio.conf
	else
		sed -Ei '/^HOOKS=\(/ s/\<udev\>/udev plymouth/' /etc/mkinitcpio.conf
	fi
}
ensure "mkinitcpio runs the plymouth hook" hook_set hook_apply

splash_set() { grep -Eq '^KERNEL_CMDLINE\[default\].*\<splash\>' /etc/default/limine; }
splash_apply() {
	sed -Ei '0,/^KERNEL_CMDLINE\[default\]/ { /^KERNEL_CMDLINE\[default\]/ s/"$/ splash"/ }' /etc/default/limine
}
ensure "limine boots with splash" splash_set splash_apply

theme_set() { [[ $(plymouth-set-default-theme) == bgrt ]]; }
theme_apply() { plymouth-set-default-theme bgrt; }
ensure "plymouth theme: bgrt" theme_set theme_apply

# The boot images only pick up the edits above when rebuilt. The stamp records the configuration
# they were last built from, so a failed or interrupted rebuild is retried on the next run.
boot_stamp=/var/lib/dotfiles-system/boot-config.sha256
boot_config() { sha256sum /etc/mkinitcpio.conf /etc/default/limine /etc/plymouth/plymouthd.conf; }
boot_built() { [[ -f $boot_stamp && $(<"$boot_stamp") == "$(boot_config)" ]]; }
boot_build() {
	limine-mkinitcpio
	boot_config | install -Dm644 /dev/stdin "$boot_stamp"
}
ensure "boot images built from the current configuration" boot_built boot_build

# noctalia-greeter owns PAM, its paths and the appearance sync; this creates its user, runs its
# setup once and points greetd at it. Its setup exits non-zero on failure, which stops this run.
greeter_lib=/usr/share/noctalia-greeter/greetd_setup_lib.sh
if [[ ! -f $greeter_lib ]]; then
	echo "dotfiles-system: noctalia-greeter is not installed; run dotfiles-packages first" >&2
	exit 1
fi
# shellcheck source=/usr/share/noctalia-greeter/greetd_setup_lib.sh
source "$greeter_lib"
greeter_user="$(resolve_greeter_user)"

greeter_set() { id -u "$greeter_user" >/dev/null 2>&1 && [[ -d /var/lib/noctalia-greeter ]]; }
greeter_apply() {
	id -u "$greeter_user" >/dev/null 2>&1 ||
		useradd -r -s /usr/bin/nologin -d /var/lib/noctalia-greeter "$greeter_user"
	/usr/share/noctalia-greeter/setup_greeter_system.sh
}
ensure "noctalia-greeter system setup" greeter_set greeter_apply

greetd_path=/etc/greetd/config.toml
greetd_config="[terminal]
vt = 1

[default_session]
command = \"$(find_session_bin)\"
user = \"$greeter_user\""
greetd_set() { [[ -f $greetd_path && $(<"$greetd_path") == "$greetd_config" ]]; }
greetd_apply() { install -Dm644 /dev/stdin "$greetd_path" <<<"$greetd_config"; }
ensure "greetd starts noctalia-greeter" greetd_set greetd_apply

dm_set() { [[ $(systemctl is-enabled greetd.service 2>/dev/null) == enabled ]]; }
# --force replaces another display manager's display-manager.service alias.
dm_apply() { systemctl enable --force greetd.service; }
ensure "greetd is the display manager" dm_set dm_apply

if $check && ((pending)); then
	exit 1
fi
