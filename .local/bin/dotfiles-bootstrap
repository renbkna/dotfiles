#!/usr/bin/env fish
# Sets up this desktop on a fresh CachyOS install after `dots checkout`, and brings a running one
# back in line; every step is idempotent. Run it from any terminal first: it installs packages and
# applies system configuration with sudo. Then log into Hyprland through the greeter and run it
# again from a terminal there, which applies the steps that need the running shell.

set -l dots ~/.config/dotfiles
set -l tyrian ~/Projects/tyrian-night

# Packages, system configuration and user services
~/.local/bin/dotfiles-packages install common; or exit 1
if not ~/.local/bin/dotfiles-system --check >/dev/null
    sudo ~/.local/bin/dotfiles-system; or exit 1
end
systemctl --user daemon-reload; or exit 1
systemctl --user enable noctalia.service monthly-trash-clean.timer gamemoded.service; or exit 1

# Myna, the terminal and editor font: the AUR package lags at 1.0, so the pinned 2.0 release
# (OFL-1.1) is installed from upstream and verified against its checksum.
set -l myna_url https://github.com/sayyadirfanali/Myna/releases/download/v2.0.0.0-beta/Myna-v2.0.0-beta.zip
set -l myna_sha256 0013ff1c868356f4dbcb9a58799a779b3c86cf2e545eafd71e3f32c38fcf8a7b
set -l myna_dir ~/.local/share/fonts/Myna
if not string match -q $myna_sha256 (cat $myna_dir/.release-sha256 2>/dev/null)
    set -l archive (mktemp --suffix=.zip)
    curl -fsSL -o $archive $myna_url; or exit 1
    if not echo "$myna_sha256  $archive" | sha256sum --check --quiet
        echo "dotfiles-bootstrap: Myna archive does not match its pinned checksum" >&2
        rm $archive
        exit 1
    end
    mkdir -p $myna_dir; and unzip -joq $archive 'fonts/*' -d $myna_dir; or exit 1
    echo $myna_sha256 >$myna_dir/.release-sha256
    rm $archive
    fc-cache $myna_dir
end

if not test -d $tyrian/.git
    git clone https://github.com/renbkna/tyrian-night.git $tyrian; or exit 1
end

# Tyrian Night files are linked, so `git pull` in the checkout updates them. A regular file in
# the way is left alone: it may be a local edit.
function link_as --argument-names source target
    if test -e $target; and not test -L $target
        echo "dotfiles-bootstrap: $target is not a symlink; move it aside and rerun" >&2
        return 1
    end
    mkdir -p (path dirname $target); and ln -sfn $source $target
end

for theme in $tyrian/terminal/ghostty/themes/*
    link_as $theme ~/.config/ghostty/themes/(path basename $theme); or exit 1
end

# The Ghostty theme names the variant; fish, Starship and fastfetch follow it. Rerun after
# changing it.
set -l variant (string match -rg '^theme\s*=\s*(tyrian-[a-z0-9-]+)\s*$' <~/.config/ghostty/config.ghostty)
if test (count $variant) -ne 1; or not test -f $tyrian/terminal/fish/conf.d/$variant.fish
    echo "dotfiles-bootstrap: config.ghostty needs one 'theme = tyrian-<variant>' line" >&2
    exit 1
end
link_as $tyrian/terminal/fish/conf.d/$variant.fish ~/.config/fish/conf.d/tyrian-night.fish; or exit 1
link_as $tyrian/terminal/fish/functions/fish_greeting.fish ~/.config/fish/functions/fish_greeting.fish; or exit 1

# Zed installs the listed registry extensions itself (auto_install_extensions); Tyrian Night is a
# dev extension from the checkout.
link_as $tyrian/apps/zed ~/.local/share/zed/extensions/installed/tyrian-night-theme; or exit 1

# VSCodium: Open VSX extensions from the list, Tyrian Night built from the checkout whenever the
# installed version differs from it.
set -l installed (codium --list-extensions --show-versions)
for extension in (dotfiles_list $dots/vscodium-extensions.txt)
    string match -q "$extension@*" $installed; or codium --install-extension $extension; or exit 1
end
set -l tyrian_version (jq -r .version $tyrian/apps/vscode/package.json)
if not contains renbkna.tyrian-night@$tyrian_version $installed
    bun install --cwd $tyrian --frozen-lockfile; or exit 1
    bun run --cwd $tyrian package:vscode; or exit 1
    codium --install-extension $tyrian/dist/tyrian-night.vsix --force; or exit 1
end

# qt6ct.conf names the icon theme. GTK reads it from dconf and KDE apps from kdeglobals, which
# the repository cannot carry.
set -l icons (string match -rg '^icon_theme=(.+)$' <~/.config/qt6ct/qt6ct.conf)
if test (count $icons) -ne 1
    echo "dotfiles-bootstrap: qt6ct.conf needs one icon_theme line" >&2
    exit 1
end
gsettings set org.gnome.desktop.interface icon-theme $icons; or exit 1
kwriteconfig6 --file kdeglobals --group Icons --key Theme $icons; or exit 1

# The rest needs the running Hyprland session.
if not set -q HYPRLAND_INSTANCE_SIGNATURE
    echo "dotfiles-bootstrap: log into Hyprland and rerun this to finish"
    exit 0
end
systemctl --user start noctalia.service; or exit 1
# Noctalia answers IPC once its shell is up; templates-apply below fails visibly if it never does.
for attempt in (seq 20)
    noctalia msg theme-mode-get >/dev/null 2>&1; and break
    sleep 0.5
end
# Writes ~/.config/hypr/noctalia.lua, which hyprland.lua requires for border colours, and the
# palette colour whose hook builds the icon theme (.local/bin/papirus-noctalia-folders).
noctalia msg templates-apply; or exit 1
hyprctl reload >/dev/null
